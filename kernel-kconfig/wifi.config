# Samsung SCSC Wi-Fi (WLBT of the Exynos 850), DNM/scsc-wlan branch of exynos850-mainline/linux.
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_SCSC_CORE=y
CONFIG_SCSC_CORE_CM=y
CONFIG_SCSC_PLATFORM=y
# Disabled: the diagnostic log in shared memory (mxlogger) writes beyond the mapped area and
# makes the kernel fail when the Wi-Fi is switched on.
# CONFIG_SCSC_MXLOGGER is not set
CONFIG_SCSC_LOGRING=y
CONFIG_SCSC_STATIC_RING=y
CONFIG_SCSC_LOG_COLLECTION=y
CONFIG_SCSC_COMMON_HCF=y
# CONFIG_SCSC_SMAPPER is not set
CONFIG_SCSC_QOS=y
CONFIG_SCSC_MMAP=y
CONFIG_SCSC_CLK20MHZ=y
CONFIG_SCSC_WLAN=y
CONFIG_SCSC_WLAN_MAX_INTERFACES=3
# CONFIG_SCSC_WLAN_GSCAN_ENABLE is not set
CONFIG_SCSC_WLAN_HIP4_PROFILING=y
CONFIG_SCSC_WLAN_SG=y
CONFIG_SCSC_WLAN_RX_NAPI=y
CONFIG_SCSC_WLAN_RX_NAPI_GRO=y
# CONFIG_SCSC_WLAN_KEY_MGMT_OFFLOAD is not set
CONFIG_SCSC_WLAN_SAE_CONFIG=y
# CONFIG_SCSC_WLAN_WIFI_SHARING is not set
# CONFIG_SCSC_WLAN_ENABLE_MAC_RANDOMISATION is not set
# CONFIG_SCSC_WLAN_AP_AUTO_RECOVERY is not set
CONFIG_SCSC_CORE_FW_LOCATION="/lib/firmware"
# CONFIG_SCSC_CORE_FW_LOCATION_AUTO is not set
# CONFIG_SCSC_WLAN_ANDROID is not set
