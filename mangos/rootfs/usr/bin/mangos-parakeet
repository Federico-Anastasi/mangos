#!/usr/bin/env python3
"""mangos-parakeet: the Parakeet transcription model kept in memory, ready to transcribe.

Parakeet (TDT 0.6B v3, 25 European languages) in 8-bit ONNX format, run by onnxruntime.
Loading it takes many seconds, so it stays on (mangos-parakeet service).

  mangos-parakeet <port>      listens on 127.0.0.1:<port>
  POST /transcribe            body: a 16 kHz, mono, 16-bit WAV file; reply: the text

Before the model, the audio is raised to a fixed peak, by at most twenty times: a distant voice
arrives quiet, and beyond that only the hiss would rise.

The model is in /opt/mangos/asr/parakeet-v3, the onnx-asr library in /opt/mangos/asr/lib.

When `pim speech` has chosen the cloud the transcription is Deepgram's: the service stays up
without loading the model, and is restarted when the choice changes.
"""
import io
import os
import signal
import sys
import wave
from http.server import BaseHTTPRequestHandler, HTTPServer

SETTINGS = "/etc/mangos/voice"


def read_pairs(path):
    """Reads a file of key=value lines; lines starting with # are comments."""
    values = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                key, equals, value = line.partition("=")
                if equals and not key.lstrip().startswith("#"):
                    values[key.strip()] = value.strip()
    except FileNotFoundError:
        pass
    return values


def speech_in_cloud():
    return read_pairs(SETTINGS).get("speech") == "cloud"


# Checked before importing onnxruntime and numpy, which alone take seconds and memory.
if __name__ == "__main__" and speech_in_cloud():
    print("mangos-parakeet: speech is in the cloud, the model is not loaded", flush=True)
    while True:
        signal.pause()

# numpy must not occupy the processors with its threads: onnxruntime does the computing.
os.environ["OPENBLAS_NUM_THREADS"] = "1"
ASR_DIR = "/opt/mangos/asr"
sys.path.insert(0, ASR_DIR + "/lib")
import numpy as np
import onnxruntime
import onnx_asr

THREADS = 8                  # with fewer threads transcription slows down
MAX_BYTES = 4 << 20          # more than two minutes of audio
PEAK = 24000 / 32768         # the peak the audio is raised to, out of 1
MAX_GAIN = 20.0


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    timeout = 30             # an idle client must not keep the only thread busy

    def reply(self, code, text):
        body = text.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            length = -1
        if not 0 <= length <= MAX_BYTES:
            self.close_connection = True
            self.reply(400, f"mangos-parakeet: need a body of at most {MAX_BYTES} bytes\n")
            return
        body = self.rfile.read(length)
        if self.path != "/transcribe":
            self.reply(404, "mangos-parakeet: only /transcribe\n")
            return
        try:
            with wave.open(io.BytesIO(body)) as f:
                if (f.getframerate(), f.getnchannels(), f.getsampwidth()) != (16000, 1, 2):
                    raise ValueError("need 16 kHz, mono, 16-bit audio")
                samples = np.frombuffer(f.readframes(f.getnframes()), dtype="<i2").astype(np.float32) / 32768
        except (wave.Error, EOFError, ValueError) as error:
            self.reply(400, f"mangos-parakeet: {error}\n")
            return
        peak = np.abs(samples).max() if samples.size else 0
        if peak:
            samples *= min(MAX_GAIN, PEAK / peak)
        try:
            text = model.recognize(samples, sample_rate=16000)
        except Exception as error:          # the model failed: whoever asked must know
            print(f"mangos-parakeet: transcription failed ({type(error).__name__}: {error})",
                  file=sys.stderr, flush=True)
            self.reply(500, f"mangos-parakeet: transcription failed ({error})\n")
            return
        self.reply(200, text)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        sys.exit(__doc__)
    options = onnxruntime.SessionOptions()
    options.intra_op_num_threads = THREADS
    model = onnx_asr.load_model("nemo-parakeet-tdt-0.6b-v3", ASR_DIR + "/parakeet-v3", quantization="int8",
                                sess_options=options, providers=["CPUExecutionProvider"])
    print("mangos-parakeet: model loaded", flush=True)
    HTTPServer(("127.0.0.1", int(sys.argv[1])), Handler).serve_forever()
