#!/usr/bin/env python3
"""mangos-speak: speaks a text aloud through the phone's speaker.

  mangos-speak <text...>   speaks the text (with no text it reads it from the input)
  mangos-speak --stop      immediately silences what the service is speaking
  mangos-speak --cached <text>
                           speaks a short fixed phrase, made once and then played at once
  mangos-speak --service   keeps the voice loaded and speaks what it is asked

The text is spoken one sentence at a time: the first is heard while the others are prepared. The
voice is local (Piper, a model from /opt/mangos/voices) or cloud (Deepgram Aura-2, key in
/etc/mangos/deepgram-key); `pim speech` chooses, and the service reads the choice when it starts,
together with voice= and cloud_voice= from /etc/mangos/voice. If Deepgram does not answer, the
sentence is not spoken and the error is printed: there is no switch to the local voice.

Loading the Piper model costs far more than speaking a sentence: so the service (started at boot)
keeps it in memory, and the command hands it the text. Without the service the command stops
with an error instead of loading a second model. Root and the pim group can talk to the service.
"""
import array
import fcntl
import hashlib
import http.client
import json
import math
import os
import queue
import re
import shutil
import socket
import ssl
import subprocess
import sys
import threading
import time
import unicodedata
import urllib.request
from itertools import zip_longest

VOICES_DIR = "/opt/mangos/voices"
SETTINGS = "/etc/mangos/voice"
DEFAULT_VOICE = "it_IT-paola-medium"
SOCKET = "/run/mangos-speak.sock"
CACHE_DIR = "/var/cache/mangos/speak"      # short phrases already made, by voice
CLOUD_KEY = "/etc/mangos/deepgram-key"
CLOUD_VOICE = "aura-2-demetra-it"
CLOUD_URL = "https://api.deepgram.com/v1/speak"
CLOUD_RATE = 24000
CLOUD_AHEAD = 3              # sentences asked for at once: the next is ready when one ends
CLOUD_TIMEOUT_S = 15
# Aura-2 arrives quiet and uneven from one sentence to the next: each sentence is brought to
# CLOUD_LEVEL while it arrives, starting from the gain of the previous one, and peaks above KNEE
# are rounded off instead of clipped.
CLOUD_LEVEL = -20.0          # dBFS, mean level of the speech
# Aura-2 has no speed control in Italian: sox's tempo speeds it up keeping the pitch.
CLOUD_SPEED = 1.15           # 1 leaves it as it is
CHARS_PER_S = 12.5           # estimate of how fast the cloud voice speaks, to time the words on screen
MAX_GAIN = 4.0               # +12 dB at most: a quiet breath must not become loud
SPEECH_FLOOR = 100           # pieces quieter than this mean amplitude are pauses: they do not count
KNEE = 0.75 * 32767
BEGIN, END, SEPARATOR = "^", "$", "_"     # the marks the model wants around and between phonemes
# How much audio can wait in the pipe to the player: the bigger it is, the sooner the next
# sentence starts being prepared, without waiting for the previous one to be nearly over.
PIPE_SIZE = 1 << 20
# A punctuation mark ends a chunk only if followed by a space or the end of the text (also after
# a quote or a parenthesis): inside "3,50", "10:30" or "1.500" it does not count.
PUNCTUATION = re.compile(r'([.!?;:,]+)(?=["»”’)]*(?:\s|$))')


def read_pairs(path):
    """Reads a file of key=value lines; lines starting with # are comments."""
    values = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                key, equals, value = line.partition("=")
                if equals and not key.lstrip().startswith("#"):
                    values[key.strip()] = value.strip()
    except FileNotFoundError:
        pass
    return values


def sentences(text):
    """The sentences of the text, each as a list of (words, closing mark)."""
    # Ellipses and dashes are pauses for espeak-ng too, which drops them from the text: better
    # to say so ourselves, as a sentence end and a comma.
    text = re.sub(r"\s*[—–]+\s*", ", ", text)
    text = re.sub(r"\s*…+\s*", ". ", text)
    parts = []
    split = PUNCTUATION.split(text) + [""]
    for words, mark in zip(split[0::2], split[1::2]):
        words = " ".join(words.split())
        if any(c.isalnum() for c in words):
            parts.append((words, mark[:1]))
        if re.search(r"[.!?]", mark):
            if parts:
                yield parts
            parts = []
    if parts:
        yield parts


def sentence_text(parts):
    return " ".join(words + mark for words, mark in parts)


class Timeline:
    """When the audio written so far will have been heard: the speaker plays it without gaps
    from the first write, at `bytes_per_s`. It tells `heard`, at the right moment, that a
    sentence starts being spoken, so the screen can show the words as they are said."""

    def __init__(self, bytes_per_s, heard):
        self.bytes_per_s, self.heard = bytes_per_s, heard
        self.until = 0.0                        # when what is written so far will have been heard
        self.timers = []

    def sentence(self, text, seconds):
        """A sentence is about to be written."""
        if self.heard:
            wait = max(0.0, self.until - time.monotonic())
            timer = threading.Timer(wait, self.heard, args=(text, seconds))
            timer.daemon = True
            timer.start()
            self.timers.append(timer)

    def wrote(self, count):
        self.until = max(self.until, time.monotonic()) + count / self.bytes_per_s

    def cancel(self):
        for timer in self.timers:
            timer.cancel()


class Synthesizer:
    """A loaded voice, ready to speak texts."""

    def __init__(self):
        values = read_pairs(SETTINGS)
        self.turn_lock = threading.Lock()       # one text at a time
        self.stopped = threading.Event()        # silence requested: the current text stops
        self.player = None
        self.timeline = None
        self.speed = 1.0
        self.cloud = values.get("speech") == "cloud"
        if self.cloud:
            self.cloud_voice = values.get("cloud_voice", CLOUD_VOICE)
            self.speed = CLOUD_SPEED
            self.target = 32767 * 10 ** (CLOUD_LEVEL / 20)
            self.gain = 2.0                     # the last sentence's, for the start of the next
            self.voice_key = f"cloud {self.cloud_voice} {CLOUD_LEVEL}"
            try:
                with open(CLOUD_KEY, encoding="utf-8") as f:
                    self.cloud_key = f.read().strip()
            except OSError as error:
                sys.exit(f"mangos-speak: no Deepgram key ({error})")
            self.sample_rate = CLOUD_RATE
            self.tls = ssl.create_default_context()     # loading the certificates takes long: once
            return
        # Imported only here: they take seconds, and neither the cloud voice nor the command that
        # hands the text to the service needs them.
        global numpy, onnxruntime
        # numpy brings OpenBLAS, which starts one thread per processor and lets them spin idle.
        # We do no matrix computation: a single thread, so none extra.
        os.environ["OPENBLAS_NUM_THREADS"] = "1"
        import numpy
        import onnxruntime
        model = f"{VOICES_DIR}/{values.get('voice', DEFAULT_VOICE)}.onnx"
        self.voice_key = f"local {model}"
        try:
            with open(model + ".json", encoding="utf-8") as f:
                card = json.load(f)
        except FileNotFoundError:
            sys.exit(f"mangos-speak: missing voice {model}")
        options = onnxruntime.SessionOptions()
        options.log_severity_level = 3          # silences warnings that do not concern the phone
        self.net = onnxruntime.InferenceSession(model, options, providers=["CPUExecutionProvider"])
        self.ids = card["phoneme_id_map"]
        self.language = card["espeak"]["voice"]
        self.sample_rate = card["audio"]["sample_rate"]
        rules = card["inference"]
        self.scale = numpy.array([rules["noise_scale"], rules["length_scale"], rules["noise_w"]],
                                 dtype=numpy.float32)

    def phonemes(self, parts):
        """The phonemes of a sentence, with the punctuation put back where espeak-ng drops it."""
        # espeak-ng starts a new line at every pause, not at every newline of the text: the commas
        # between one chunk and the next make one line per chunk. With "--" the text, which may
        # start with a dash, is not mistaken for an option.
        result = subprocess.run(["espeak-ng", "-q", "--ipa", "-v", self.language, "--",
                                 ", ".join(words for words, _ in parts)],
                                capture_output=True, text=True, check=True)
        lines = [r.strip() for r in result.stdout.splitlines() if r.strip()]
        marks = [mark for _, mark in parts]
        return unicodedata.normalize("NFD", " ".join(
            line + (mark or ",") for line, mark in zip_longest(lines, marks, fillvalue="")))

    def wave(self, parts):
        """The voice of a sentence, as samples from -1 to 1."""
        sequence = list(self.ids[BEGIN])
        for phoneme in self.phonemes(parts):
            if phoneme in self.ids:
                sequence += self.ids[phoneme] + self.ids[SEPARATOR]
        sequence += self.ids[END]
        return self.net.run(None, {
            "input": numpy.array([sequence], dtype=numpy.int64),
            "input_lengths": numpy.array([len(sequence)], dtype=numpy.int64),
            "scales": self.scale,
        })[0].squeeze()

    def say(self, text):
        """Speaks the text and returns when done. The result is aplay's exit code, 1 if the
        cloud voice failed."""
        return self.say_stream([text])

    def say_stream(self, texts, heard=None):
        """Speaks the texts one after another with the speaker always open; `texts` may yield
        them as they arrive (the entity's reply while it is being written). `heard`, if given,
        is called with each sentence and its length in seconds when it starts being heard."""
        with self.turn_lock:
            return self.say_now(texts, heard)

    def cached_audio(self, text):
        """The voice of a short fixed phrase (the greeting when the entity is tapped): made the
        first time and kept in CACHE_DIR, one file per voice and phrase. None if it could not be had."""
        name = hashlib.sha1(f"{self.voice_key}|{text}".encode()).hexdigest()
        path = f"{CACHE_DIR}/{name}.raw"
        try:
            with open(path, "rb") as f:
                return f.read()
        except FileNotFoundError:
            pass
        audio = self.render(text)
        if audio is not None:
            os.makedirs(CACHE_DIR, exist_ok=True)
            part = f"{path}.{threading.get_ident()}.part"   # two threads may make the same phrase
            with open(part, "wb") as f:
                f.write(audio)
            os.replace(part, path)
        return audio

    def say_cached(self, text):
        """Speaks a short fixed phrase at once."""
        audio = self.cached_audio(text)
        if audio is None:
            return 1
        with self.turn_lock:
            return self.say_now([], None, audio)

    def render(self, text):
        """The voice of a text as raw samples, without playing it; None if it could not be had."""
        parts = list(sentences(text))
        if not self.cloud:
            return b"".join((numpy.clip(self.wave(p), -1, 1) * 32767).astype("<i2").tobytes() for p in parts)
        try:
            return b"".join(piece for p in parts for piece in self.cloud_audio(sentence_text(p)))
        except (OSError, http.client.HTTPException) as error:
            print(f"mangos-speak: the cloud voice did not answer ({error})", file=sys.stderr, flush=True)
            return None

    def say_now(self, texts, heard, audio=None):
        """Speaks the texts, or plays `audio` (raw samples) if given."""
        self.stopped.clear()
        self.player = player = subprocess.Popen(
            ["aplay", "-q", "-D", "default", "-t", "raw", "-f", "S16_LE", "-r", str(self.sample_rate),
             "-c", "1", "-"], stdin=subprocess.PIPE)
        fcntl.fcntl(player.stdin.fileno(), fcntl.F_SETPIPE_SZ, PIPE_SIZE)
        out, stretcher, speed = player.stdin, None, 1.0
        cloud_failed = False
        try:
            if self.cloud and self.speed != 1.0:
                # Faster speech, at the same pitch: sox's tempo works on the stream as it passes.
                speed = self.speed
                stretcher = subprocess.Popen(
                    ["sox", "-q", "-t", "raw", "-r", str(CLOUD_RATE), "-e", "signed", "-b", "16", "-c", "1", "-",
                     "-t", "raw", "-", "tempo", "-s", str(speed)], stdin=subprocess.PIPE, stdout=player.stdin)
                player.stdin.close()            # sox writes to it now
                out = stretcher.stdin
            self.timeline = Timeline(2 * self.sample_rate * speed, heard)
            all_sentences = (parts for text in texts for parts in sentences(text))
            if audio is not None:
                out.write(audio)
            elif self.cloud:
                cloud_failed = not self.play_cloud(all_sentences, out)
            else:
                self.play_local(all_sentences, out)
        except BrokenPipeError:
            pass                                # aplay has already said why it stopped
        finally:
            try:
                out.close()
            except BrokenPipeError:
                pass
        if stretcher:
            stretcher.wait()
        result = player.wait()
        return 1 if cloud_failed else result

    def play_local(self, all_sentences, out):
        for parts in all_sentences:
            if self.stopped.is_set():
                break
            wave = self.wave(parts)
            self.timeline.sentence(sentence_text(parts), len(wave) / self.sample_rate)
            # A quarter of a second of silence between sentences.
            wave = numpy.concatenate([wave, numpy.zeros(self.sample_rate // 4, dtype=wave.dtype)])
            data = (numpy.clip(wave, -1, 1) * 32767).astype("<i2").tobytes()
            out.write(data)
            out.flush()
            self.timeline.wrote(len(data))

    def cloud_audio(self, text):
        """The voice of a sentence from Deepgram, as raw 16-bit samples, piece by piece as it
        arrives."""
        request = urllib.request.Request(
            f"{CLOUD_URL}?model={self.cloud_voice}&encoding=linear16&sample_rate={CLOUD_RATE}"
            "&container=none",
            data=json.dumps({"text": text}).encode(),
            headers={"Authorization": f"Token {self.cloud_key}", "Content-Type": "application/json"})
        rest = b""                              # half a sample left from the previous piece
        level = {"gain": self.gain, "squares": 0.0, "count": 0}
        with urllib.request.urlopen(request, timeout=CLOUD_TIMEOUT_S, context=self.tls) as response:
            while piece := response.read(4096):
                piece, rest = rest + piece, b""
                if len(piece) % 2:
                    piece, rest = piece[:-1], piece[-1:]
                yield self.louder(piece, level)
        self.gain = level["gain"]

    def louder(self, data, level):
        """The 16-bit samples brought towards the target level. `level` is the sentence so far:
        its speech energy and the gain reached, which moves smoothly across each piece."""
        samples = array.array("h", data)
        if not samples:
            return data
        squares = sum(s * s for s in samples)
        if math.sqrt(squares / len(samples)) > SPEECH_FLOOR:
            level["squares"] += squares
            level["count"] += len(samples)
        start = level["gain"]
        if level["count"]:
            mean = math.sqrt(level["squares"] / level["count"])
            level["gain"] = min(MAX_GAIN, max(1.0, self.target / mean))
        step = (level["gain"] - start) / len(samples)
        top = 32767 - KNEE
        for i, s in enumerate(samples):
            v = s * (start + step * i)
            if abs(v) > KNEE:
                v = math.copysign(KNEE + top * math.tanh((abs(v) - KNEE) / top), v)
            samples[i] = int(v)
        return samples.tobytes()

    def play_cloud(self, all_sentences, out):
        """Speaks the sentences with the cloud voice. Up to CLOUD_AHEAD are requested at once,
        each into its own queue; a second thread plays the queues in order, every piece as soon
        as it arrives. Returns False if a sentence could not be had."""
        order = queue.Queue()                   # the queues of the sentences, in order
        slots = threading.Semaphore(CLOUD_AHEAD)
        errors = []
        silence = bytes(2 * CLOUD_RATE // 4)    # a quarter of a second between sentences

        def fetch(text, pieces):
            try:
                for piece in self.cloud_audio(text):
                    pieces.put(piece)
            except Exception as error:          # no network, refused key, timeout, a cut connection
                errors.append(error)
            finally:
                pieces.put(None)                # whoever plays waits for it, whatever happened

        def play():
            # Once stopped it keeps emptying the queues, so that nobody waits on a free slot.
            while (item := order.get()) is not None:
                text, pieces = item
                first = True
                while (piece := pieces.get()) is not None:
                    if not self.stopped.is_set():
                        if first:
                            # Its length is not known yet: estimated from its letters.
                            self.timeline.sentence(text, len(text) / CHARS_PER_S / self.speed)
                            first = False
                        try:
                            out.write(piece)
                            out.flush()
                        except BrokenPipeError:
                            self.stopped.set()
                        self.timeline.wrote(len(piece))
                if not self.stopped.is_set():
                    try:
                        out.write(silence)
                    except BrokenPipeError:
                        self.stopped.set()
                    self.timeline.wrote(len(silence))
                slots.release()

        player = threading.Thread(target=play, daemon=True)
        player.start()
        for parts in all_sentences:
            if self.stopped.is_set():
                break
            slots.acquire()
            pieces = queue.Queue()
            text = sentence_text(parts)
            threading.Thread(target=fetch, args=(text, pieces), daemon=True).start()
            order.put((text, pieces))
        order.put(None)
        player.join()
        if errors:
            print(f"mangos-speak: the cloud voice did not answer ({errors[0]})", file=sys.stderr, flush=True)
        return not errors

    def stop(self):
        """Stops the current text and returns when the speaker is free (what the speaker already
        has buffered is still heard)."""
        self.stopped.set()
        if self.timeline:
            self.timeline.cancel()              # what will not be heard is not shown either
        player = self.player
        if player and player.poll() is None:
            player.terminate()
        with self.turn_lock:
            return 0


def texts_from(connection, stopped):
    """The texts of a streamed request, as they arrive: a JSON line with "text" for each, and one
    with "end" at the bottom. A separate thread reads the lines, because whoever speaks the texts
    must be able to stop (`stopped`) even while the next one has not arrived yet."""
    arrived = queue.Queue()

    def read():
        try:
            for line in connection:
                try:
                    request = json.loads(line)
                except ValueError:
                    continue
                if request.get("end"):
                    break
                if request.get("text"):
                    arrived.put(str(request["text"]))
        except (OSError, ValueError):
            pass                                # the sender closed
        arrived.put(None)

    threading.Thread(target=read, daemon=True).start()
    while not stopped.is_set():
        try:
            text = arrived.get(timeout=0.2)
        except queue.Empty:
            continue
        if text is None:
            return
        yield text


def serve():
    """Keeps the model in memory and speaks one request at a time. Each request is a JSON line
    with "text", or with "stop"; the reply, once the speech is done, is the player's exit code. A
    request with "stream" is followed by more lines, one per text, and by one with "end": the
    texts are spoken as they come, without closing the speaker between one and the next; while
    speaking, the service writes back a JSON line {"heard": sentence, "seconds": length} when
    each sentence starts being heard, before the final result."""
    # Drop the socket of a previous service at once: until the model is loaded there is none.
    if os.path.exists(SOCKET):
        os.unlink(SOCKET)
    synthesizer = Synthesizer()
    server = socket.socket(socket.AF_UNIX)
    server.bind(SOCKET)
    shutil.chown(SOCKET, group="pim")           # root and pim, nobody else (pim speaks without doas)
    os.chmod(SOCKET, 0o660)
    server.listen()

    def handle(client):
        with client, client.makefile("rw", encoding="utf-8") as f:
            writing = threading.Lock()

            def heard(text, seconds):
                # The sentence is being said: whoever asked for the voice shows its words now.
                with writing:
                    try:
                        f.write(json.dumps({"heard": text, "seconds": round(seconds, 2)}) + "\n")
                        f.flush()
                    except (OSError, ValueError):
                        pass                    # the requester no longer listens

            try:
                request = json.loads(f.readline())
                if request.get("stop"):
                    result = synthesizer.stop()
                elif request.get("stream"):
                    result = synthesizer.say_stream(texts_from(f, synthesizer.stopped), heard)
                elif request.get("cache"):
                    result = synthesizer.say_cached(str(request["text"]))
                else:
                    result = synthesizer.say(str(request["text"]))
            except (ValueError, KeyError, TypeError, OSError, subprocess.CalledProcessError) as error:
                print(f"mangos-speak: request not carried out ({error})", file=sys.stderr, flush=True)
                result = 1
            with writing:
                try:
                    f.write(f"{result}\n")
                    f.flush()
                except OSError:
                    pass                        # the requester no longer waits

    while True:
        threading.Thread(target=handle, args=(server.accept()[0],), daemon=True).start()


def main():
    args = sys.argv[1:]
    if args == ["--service"]:
        serve()
    if args == ["--stop"]:
        request = {"stop": True}
    elif args[:1] == ["--cached"] and len(args) == 2:
        request = {"text": args[1], "cache": True}
    else:
        text = " ".join(args) if args else sys.stdin.read()
        if not text.strip():
            sys.exit(__doc__.strip())
        request = {"text": text}
    try:
        server = socket.socket(socket.AF_UNIX)
        server.connect(SOCKET)
    except OSError:
        # Without the service nobody is speaking: there is nothing to stop.
        sys.exit(0 if "stop" in request else "mangos-speak: the service is not running (rc-service mangos-speak start)")
    with server, server.makefile("rw", encoding="utf-8") as f:
        f.write(json.dumps(request) + "\n")
        f.flush()
        sys.exit(int(f.readline() or 1))


if __name__ == "__main__":
    main()
